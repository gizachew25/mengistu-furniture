# ─────────────────────────────────────────────────────────────
#  Mengistu Furniture — Environment Configuration (EXAMPLE)
#  Copy this file to ".env" and replace every value below.
#  NEVER commit the real .env file. NEVER put real secrets here.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
# Public origin of the site (used for CORS + absolute URLs). No trailing slash.
APP_URL=http://localhost:4000
# Comma-separated list of extra allowed CORS origins (optional)
CORS_ORIGINS=http://localhost:4000,http://localhost:5500

# ── PostgreSQL ────────────────────────────────────────────────
# Either provide DATABASE_URL, OR the individual PG* values below.
DATABASE_URL=postgresql://mengistu:change_this_password@localhost:5432/mengistu_furniture
PGHOST=localhost
PGPORT=5432
PGUSER=mengistu
PGPASSWORD=change_this_password
PGDATABASE=mengistu_furniture
# Set to "true" only if your PostgreSQL requires SSL (e.g. managed cloud DB)
PGSSL=false

# ── Security / Auth ───────────────────────────────────────────
# Generate strong random secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_48_bytes
JWT_EXPIRES_IN=2h
# Name of the HTTP-only cookie holding the session token
COOKIE_NAME=mf_session
# Set to "true" in production behind HTTPS so cookies are Secure
COOKIE_SECURE=false

# ── Uploads ───────────────────────────────────────────────────
# Max upload size per image in megabytes
MAX_UPLOAD_MB=5
# Directory (relative to project root) where uploaded images are stored
UPLOAD_DIR=uploads

# ── Initial Super Admin (used by "npm run create:admin" / seed) ─
SEED_ADMIN_NAME=Mengistu Teshome
SEED_ADMIN_EMAIL=mengistuteshome@gmail.com
SEED_ADMIN_PHONE=+251970801754
# Change this immediately after first login.
# NOTE: wrap the value in quotes if it contains a '#' (otherwise it is read as a comment).
SEED_ADMIN_PASSWORD="ChangeMe#2026"

# ── Business info (surfaced to the public API / settings) ─────
BUSINESS_TELEBIRR_NUMBER=+251970801754
